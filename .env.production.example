# =============================================================================
# Variables de entorno de PRODUCCIÓN — Sistema de Reservas de Aulas
# Copiar este archivo a `.env.production` y completar con valores reales.
# NUNCA versionar `.env.production` en git.
# =============================================================================

# --- Base de datos PostgreSQL (contenedor `postgres`) ---
POSTGRES_USER=reservas_prod
POSTGRES_PASSWORD=reemplazar_con_password_postgres_seguro
POSTGRES_DB=reservas

# --- Backend (Express + Sequelize) ---
NODE_ENV=production
PORT=3001
# En Docker Compose productivo el host del servicio es `postgres`.
# Si se utiliza un PostgreSQL gestionado externo, reemplazar por la URL del proveedor (con ?sslmode=require).
DATABASE_URL=postgres://reservas_prod:reemplazar_con_password_postgres_seguro@postgres:5432/reservas

# Clave para firma de JWT locales (generar con: openssl rand -hex 32)
JWT_SECRET=reemplazar_con_secreto_jwt_aleatorio_minimo_32_bytes

# Clave secreta de Clerk de producción (obligatoria cuando NODE_ENV=production)
CLERK_SECRET_KEY=sk_live_reemplazar_con_clave_secreta_clerk

# Orígenes permitidos por CORS (separados por coma, sin barra final)
CORS_ORIGINS=https://reservas.tudominio.edu.ar,http://localhost

# Horario laboral permitido para reservas (formato HH:MM)
WORK_HOUR_START=08:00
WORK_HOUR_END=22:00
LOG_SQL=false

# --- Frontend (Build de Vite + Nginx) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_live_reemplazar_con_clave_publica_clerk
VITE_API_BASE_URL=/api

# --- Puertos en el host ---
FRONTEND_PORT=80
BACKEND_PORT=3001
