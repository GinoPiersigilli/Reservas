# Clave pública de Clerk. Sin esto la aplicación no arranca: muestra una
# pantalla que lo avisa en lugar de la interfaz.
# Se saca del panel de Clerk, en API keys > Publishable key. Es pública: viaja
# al navegador en el bundle, a diferencia de CLERK_SECRET_KEY, que es del
# backend y nunca sale del servidor.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_reemplazar_con_tu_clave

# Dirección de la API. Si se omite, el frontend usa http://localhost:3001/api,
# que es donde levanta el backend en desarrollo.
VITE_API_BASE_URL=http://localhost:3001/api
