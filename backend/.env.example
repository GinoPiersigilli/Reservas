# Base de datos PostgreSQL
DATABASE_URL=postgres://reservas_user:reservas_pass@localhost:5432/reservas
DATABASE_URL_TEST=postgres://reservas_user:reservas_pass@localhost:5432/reservas_test
LOG_SQL=false

# Observabilidad
# LOG_LEVEL: debug | info | warn | error | silent (en pruebas: silent)
LOG_LEVEL=info
# Umbral en milisegundos para registrar una consulta como lenta
SLOW_QUERY_MS=300

# Autenticación Clerk y JWT local
CLERK_SECRET_KEY=sk_test_reemplazar_con_tu_clave
JWT_SECRET=reemplazar_con_secreto_jwt_seguro

# Servidor y CORS
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=1

# Horario laboral de reservas (formato HH:MM)
WORK_HOUR_START=08:00
WORK_HOUR_END=22:00
